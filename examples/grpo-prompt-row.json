      "target_stage": "S3",
      "items": [
        "small_case_executed",
        "output_shape_checked",
        "non_degeneracy_checked",
        "failure_diagnosed",
        "correction_executed",
        "corrected_result_verified"
      ]
    },
    "provenance": {
