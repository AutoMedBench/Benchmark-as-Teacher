# Keep generated data, run records, checkpoints, and local environments out of
# this source-only release.  The allowlist makes accidental additions visible.
/*
!/.gitignore
!/LICENSE
!/README.md
!/README_zh.md
!/pyproject.toml
!/pytest.ini
!/config/
!/docs/
!/examples/
!/rl/
!/scripts/
!/spec/
!/tests/

__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

artifacts/
checkpoints/
data/
outputs/
results/
runs/
wandb/
*.jsonl
*.log
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.parquet
.env
.env.*
*.pem
*.key
models/
